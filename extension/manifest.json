{
  "manifest_version": 3,
  "name": "LLM Prompt Analyzer",
  "version": "1.0",
  "description": "Analyze your prompt quality and predict token usage before sending to any LLM.",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:8000/*"],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*",
        "http://localhost:*/*",
        "https://*/*"
      ],
      "js": ["content.js"]
    }
  ]
}
